# Copy to .env and adjust. All backend settings use the EKIP_ prefix (see backend/app/core/config.py).
EKIP_API_KEY=                     # set to require an X-API-Key header (frontend forwards it automatically)
EKIP_LLM_MODEL=qwen2.5:3b         # any Ollama model
EKIP_LLM_BACKEND=ollama           # ollama | hf | extractive
EKIP_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EKIP_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
EKIP_DEVICE=auto                  # auto | cpu | cuda
EKIP_MAX_UPLOAD_MB=50
